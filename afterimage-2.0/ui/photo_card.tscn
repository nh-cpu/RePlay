[gd_scene format=3]
[ext_resource type="Script" path="res://ui/photo_drag_handle.gd" id="drag"]
[ext_resource type="Texture2D" path="res://assets/menu/close.tres" id="close"]

[node name="PhotoCard" type="HBoxContainer"]
theme_override_constants/separation = 6
