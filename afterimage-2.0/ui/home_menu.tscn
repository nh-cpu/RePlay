[gd_scene format=3]
[ext_resource type="Script" path="res://ui/home_menu.gd" id="1"]
[ext_resource type="Theme" path="res://assets/menu/menu_theme.tres" id="theme"]
[ext_resource type="PackedScene" path="res://ui/menu_backdrop.tscn" id="backdrop"]
[ext_resource type="PackedScene" path="res://ui/menu_artwork.tscn" id="art"]
[ext_resource type="PackedScene" path="res://ui/song_wheel.tscn" id="wheel"]
[ext_resource type="Script" path="res://ui/atlas_toggle.gd" id="toggle"]
[node name="HomeMenu" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("theme")
script = ExtResource("1")
[node name="Background" parent="." instance=ExtResource("backdrop")]
[node name="Artwork" parent="." instance=ExtResource("art")]
[node name="Header" type="VBoxContainer" parent="."]
mouse_filter = 2
[node name="Brand" type="Label" parent="Header"]
theme_type_variation = &"TitleLabel"
theme_override_font_sizes/font_size = 28
text = "AFTERIMAGE / SELECT"
[node name="Count" type="Label" parent="Header"]
theme_type_variation = &"SectionLabel"
text = "YOUR MEMORIES, IN RHYTHM"
[node name="Details" type="VBoxContainer" parent="."]
mouse_filter = 2
theme_override_constants/separation = 10
[node name="Artwork" type="TextureRect" parent="Details"]
custom_minimum_size = Vector2(0, 142)
expand_mode = 1
stretch_mode = 6
mouse_filter = 2
[node name="Title" type="Label" parent="Details"]
theme_type_variation = &"TitleLabel"
theme_override_font_sizes/font_size = 34
text_overrun_behavior = 3
max_lines_visible = 2
autowrap_mode = 2
[node name="Artist" type="Label" parent="Details"]
theme_override_font_sizes/font_size = 16
text_overrun_behavior = 3
[node name="Stats" type="Label" parent="Details"]
theme_override_font_sizes/font_size = 16
[node name="Best" type="Label" parent="Details"]
theme_type_variation = &"ScoreLabel"
theme_override_font_sizes/font_size = 22
[node name="Wheel" parent="." instance=ExtResource("wheel")]
anchors_preset = 0
anchor_right = 0.0
anchor_bottom = 0.0
[node name="Footer" type="VBoxContainer" parent="."]
theme_override_constants/separation = 8
[node name="Status" type="Label" parent="Footer"]
theme_override_font_sizes/font_size = 13
text = "SCROLL / ↑ ↓ SONGS   ·   ← → DIFFICULTY   ·   ENTER TO PLAY"
text_overrun_behavior = 3
custom_minimum_size = Vector2(0, 20)
[node name="Actions" type="HBoxContainer" parent="Footer"]
theme_override_constants/separation = 12
[node name="Create" type="Button" parent="Footer/Actions"]
custom_minimum_size = Vector2(0, 52)
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 15
text = "+ CREATE FROM PHOTOS"
[node name="Play" type="Button" parent="Footer/Actions"]
custom_minimum_size = Vector2(120, 52)
size_flags_horizontal = 3
text = "PLAY →"
[node name="Options" type="HBoxContainer" parent="Footer"]
theme_override_constants/separation = 12
[node name="Album" type="CheckButton" parent="Footer/Options"]
custom_minimum_size = Vector2(0, 36)
size_flags_horizontal = 3
text = "Album background"
script = ExtResource("toggle")
[node name="Retry" type="Button" parent="Footer/Options"]
visible = false
theme_override_font_sizes/font_size = 13
text = "RETRY GENERATION"
